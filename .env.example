# Self-hosting: use your own provider API keys and a dedicated Neon database.
# Run npm run db:migrate before starting the app.
# Open /app to enter your own OpenAI and Context.dev API keys in the browser.
# Self-hosted deployments use API keys only; Context.dev sign-in is reserved for enrichable.io.
# Do not configure Context.dev OAuth credentials or a session secret for self-hosting.
DATABASE_URL=

# Optional live sheet updates and collaborator selections. Enable Realtime on your Neon branch,
# run npm run db:migrate, and copy these values from Postgres database -> Realtime.
# Keep the secret server-only. Without these variables the app uses 30-second polling.
# NEON_REALTIME_URL=wss://your-branch.rt.region.aws.neon.tech/
# NEON_REALTIME_SECRET=
# ENRICHABLE_REALTIME_ENABLED=true

# Optional server-side keys for a private deployment. Because anyone with the URL could spend
# them, they are only used when ENRICHABLE_PASSWORD is set and the browser sends it, or when you
# deliberately set ENRICHABLE_ALLOW_SERVER_KEYS_WITHOUT_PASSWORD=true.
# OPENAI_API_KEY=
# CONTEXT_DEV_API_KEY=
# TYPESAFE_API_KEY=
# HUNTER_API_KEY=
# PROSPEO_API_KEY=
# ENRICHABLE_PASSWORD=
# ENRICHABLE_ALLOW_SERVER_KEYS_WITHOUT_PASSWORD=false

# Default OpenAI model when the browser doesn't choose one.
# OPENAI_MODEL=gpt-5.4-mini

# Public origin for canonical and Open Graph URLs (defaults to your Vercel production domain).
# Search indexing is off unless this is the official site or ENRICHABLE_ALLOW_INDEXING=true.
# NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app
# ENRICHABLE_ALLOW_INDEXING=false

# Optional Databuddy product analytics (page views, Web Vitals, errors and anonymous product events).
# Off when unset. Never sends sheet contents, prompts or keys.
# NEXT_PUBLIC_DATABUDDY_CLIENT_ID=

# Stable server-only encryption root (32+ random characters) for recoverable MCP keys and organization provider credentials.
# MUST be identical on every local/cloud environment sharing DATABASE_URL.
# Keep it backed up; changing it requires re-encrypting existing keys first.
ENRICHABLE_MCP_ENCRYPTION_SECRET=

# Optional own-provider keys for private deployments (same password gate as above).
# QUICKENRICH_API_KEY=
# APOLLO_API_KEY=
# CONTACTOUT_API_KEY=

# Optional read-only report of all organizations' included AI and email credit balances.
# Generate a dedicated random secret (32+ characters); never use a NEXT_PUBLIC_ variable.
# ENRICHABLE_CREDITS_REPORT_SECRET=
