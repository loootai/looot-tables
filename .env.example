# Supabase project settings (Project Settings, API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.example.invalid
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# looot agent token. Server only, never exposed to the browser.
# Create one in the looot dashboard under Settings, Agent tokens.
# Tick catalog.read, runs.read, runs.execute and usage.read.
LOOOT_TOKEN=your-looot-agent-token
# Optional, defaults to https://api.looot.ai
LOOOT_API_URL=https://api.looot.ai
