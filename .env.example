# Self-hosting: use your own looot token and OpenAI key, and a dedicated Postgres database.
# Run npm run db:migrate before starting the app.
# Open /app to enter your own looot token and OpenAI key in the browser.
# DATABASE_URL can be a Neon database or any Postgres. Neon hosts use Neon's driver, everything else the normal
# Postgres driver. Set DATABASE_DRIVER=neon or postgres to force one.
DATABASE_URL=
# DATABASE_DRIVER=

# Optional live sheet updates and collaborator selections. Enable Realtime on your Neon branch,
# run npm run db:migrate, and copy these values from Postgres database -> Realtime.
# Keep the secret server-only. Without these variables the app uses 30-second polling.
# NEON_REALTIME_URL=wss://your-branch.rt.region.aws.neon.tech/
# NEON_REALTIME_SECRET=
# LOOOT_TABLES_REALTIME_ENABLED=true

# Optional server-side keys for a private deployment. Because anyone with the URL could spend
# them, they are only used when LOOOT_TABLES_PASSWORD is set and the browser sends it, or when you
# deliberately set LOOOT_TABLES_ALLOW_SERVER_KEYS_WITHOUT_PASSWORD=true.
# Every run is billed to this token's balance. There is no shared token and no included credit.
# LOOOT_TOKEN=
# OPENAI_API_KEY=
# TYPESAFE_API_KEY=
# Optional flat-fee contact data. Emails, mobiles and profiles are tried on your MoltSets plan before looot.
# MOLTSETS_API_KEY=
# LOOOT_TABLES_PASSWORD=
# LOOOT_TABLES_ALLOW_SERVER_KEYS_WITHOUT_PASSWORD=false

# Reach looot through a proxy instead of https://api.looot.ai. Leave unset to use looot directly.
# LOOOT_API_URL=

# Reach MoltSets through a proxy or a local stand-in instead of https://api.moltsets.com. The key is sent only to this address.
# MOLTSETS_API_URL=

# Send OpenAI calls to an OpenAI-compatible endpoint instead of api.openai.com (a proxy, a local model, or the
# stand-in from scripts/mock-looot.mjs --openai). Local addresses need LOOOT_TABLES_ALLOW_LOCAL_BASE_URL=true in production.
# OPENAI_BASE_URL=
# LOOOT_TABLES_ALLOW_LOCAL_BASE_URL=false

# Default OpenAI model when the browser doesn't choose one.
# OPENAI_MODEL=gpt-5.4-mini

# Public origin for canonical and Open Graph URLs (defaults to your Vercel production domain).
# Search indexing is off unless LOOOT_TABLES_ALLOW_INDEXING=true.
# NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app
# LOOOT_TABLES_ALLOW_INDEXING=false

# Optional Databuddy product analytics (page views, Web Vitals, errors and anonymous product events).
# Off when unset. Never sends sheet contents, prompts or keys.
# NEXT_PUBLIC_DATABUDDY_CLIENT_ID=

# Stable server-only encryption root (32+ random characters) for recoverable MCP keys and organization provider credentials.
# MUST be identical on every local/cloud environment sharing DATABASE_URL.
# Keep it backed up; changing it requires re-encrypting existing keys first.
LOOOT_TABLES_MCP_ENCRYPTION_SECRET=
