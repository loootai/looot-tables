# The looot tables MCP endpoint and its organization key (Configuration -> Agent access in looot tables).
LOOOT_TABLES_MCP_URL=http://localhost:3000/mcp
LOOOT_TABLES_MCP_KEY=lt_mcp_...
# Self-hosted looot tables keeps provider keys in the browser, so the agent sends its own.
LOOOT_TOKEN=
OPENAI_API_KEY=
# The model: Claude when ANTHROPIC_API_KEY is set, else OpenAI with OPENAI_API_KEY.
ANTHROPIC_API_KEY=
# Optional: the looot MCP for direct lookups, with your looot token.
# LOOOT_MCP_URL=
